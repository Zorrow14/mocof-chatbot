{
  "version": 2,
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",       "destination": "/public/index.html" },
    { "source": "/widget", "destination": "/public/widget.html" }
  ]
}